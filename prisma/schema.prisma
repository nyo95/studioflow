// Role drives BOTH permission grants (src/core/rbac/matrix.ts) and which app
// surface a user may enter (src/core/rbac/app-access.ts). Adding a value here
// is a compile-time breaking change on purpose: ROLE_PERMISSIONS and
// APP_ACCESS are typed as Record<Role, ...>, so TypeScript refuses to build
// until the new role is explicitly granted (or explicitly denied) everywhere.
// Never widen this enum without updating both matrices.
enum Role {
  // ADMIN = studio boss. Full web-app admin access, but NOT the SketchUp
  // plugin surface (API keys, merge queue, synced-code swaps) — that is
  // DEVELOPER-only. (This role absorbed the former OWNER role.)
  ADMIN
  // DEVELOPER = technical superuser. Everything ADMIN has PLUS the SketchUp
  // plugin surface, which is hard-gated to role === "DEVELOPER" at each call
  // site. isAdminLevel(ADMIN|DEVELOPER) is true for both.
  DEVELOPER
  DIC
  DRIC
  // STAFF maintains Master Data (vendors, offerings, SKUs, prices, samples).
  // Material/promotion curation is NOT a STAFF capability — it belongs to
  // admin-level roles (ADMIN, DEVELOPER) only. (This role absorbed the former
  // CURATOR role, minus the two approval permissions.)
  STAFF
  // ESTIMATOR = BQ subapp only. Shares StudioFlow login/identity but has no
  // StudioFlow project surface. See UPSTREAM-BQ-MATERIAL-SOURCE.md §0.2:
  // granular BQ_* permissions are enforced inside BQ, not here. StudioFlow
  // holds exactly one BQ permission (BQ_ACCESS) to gate the /bq entry point.
  ESTIMATOR

  @@schema("studioflow")
}

