// Non-destructive annotation of a designer's render. The image (image_url) is
// stored as-is and never modified; annotations are a separate overlay layer
// (pin coordinates as % of the image + a link to a Product Schedule entry), so
// deleting annotations leaves the render untouched.
model RenderBoard {
  id          String             @id @default(uuid())
  project_id  String
  title       String             @default("Render Board")
  image_url   String
  image_ratio Float? // natural width / height, for stable layout
  sort_order  Int                @default(0)
  created_by  String
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt
  project     Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  annotations RenderAnnotation[]

  @@index([project_id, sort_order])
  @@schema("studioflow")
}

model RenderAnnotation {
  id                String                @id @default(uuid())
  board_id          String
  schedule_entry_id String?
  pin_x             Float // 0-100, % of image width
  pin_y             Float // 0-100, % of image height
  label_side        RenderLabelSide       @default(auto)
  note              String? // optional per-pin override / extra text
  sort_order        Int                   @default(0)
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt
  board             RenderBoard           @relation(fields: [board_id], references: [id], onDelete: Cascade)
  schedule_entry    ProjectScheduleEntry? @relation(fields: [schedule_entry_id], references: [id], onDelete: SetNull)

  @@index([board_id, sort_order])
  @@schema("studioflow")
}

enum RenderLabelSide {
  auto
  left
  right

  @@schema("studioflow")
}

// ============================================================================
// BQ — FIXTURE BREAKDOWN (schema `bq`)
// ============================================================================
//
// Sumber: `D:\Misc\ProjectsHUB\BQ\PRD_Fixture_Breakdown.md`. Dibangun sebagai
// subapp DI DALAM StudioFlow di `/bq` (keputusan owner 2026-08-19) — bukan
// repo terpisah seperti yang diasumsikan `UPSTREAM-BQ-MATERIAL-SOURCE.md` §0.
// Konsekuensi keputusan itu ada di `AGENTS.md` §🧾 BQ Contract.
//
// ----------------------------------------------------------------------------
// TIGA LAPIS, TIDAK LEBIH
// ----------------------------------------------------------------------------
//   L1 BqObject      satu fixture utuh — qty, unit, markup, rate hasil hitung
//     L2 BqSubObject   bagian fixture — PUNYA QTY PENGALI SENDIRI
//       L3 BqMaterialLine / BqServiceLine   baris biaya paling dasar
//
// Tidak ada sub-sub-object (PRD §2.2). Kalau ada bagian yang terasa perlu
// lapis keempat, ia dipecah jadi dua L2 sejajar. Nesting tak terbatas
// terdengar fleksibel tapi membuat perhitungan, tampilan, dan agregasi
// pembelian jauh lebih rumit tanpa kasus nyata yang menuntutnya.
//
// ----------------------------------------------------------------------------
// KENAPA BAHAN DAN JASA DUA TABEL, BUKAN SATU DENGAN KOLOM NULLABLE
// ----------------------------------------------------------------------------
// PRD §3.2: baris jasa tidak punya waste dan tidak punya konversi,
// *"Ditegakkan lewat skema — tabel baris jasa memang tidak punya kolomnya."*
// AT-07 menguji tepat itu. Satu tabel dengan `waste_override_pct` nullable
// akan membuat AT-07 lolos hanya selama ada yang ingat menulis cek
// aplikasinya. Dua tabel membuatnya mustahil dilanggar.
//
// Efek sampingnya kebetulan menguntungkan: FR-EXP-03 memang meminta baris
// dikelompokkan bahan dulu, jasa kemudian.
//
// ----------------------------------------------------------------------------
// KENAPA SNAPSHOT ADA DI SETIAP BARIS L3
// ----------------------------------------------------------------------------
// PRD §5.4 — larangan silent update, *"aturan yang paling tidak boleh
// dilanggar"*. Setiap baris L3 membekukan harga, konversi, satuan, waste
// default, dan tanggal saat baris itu dibuat. Sistem TIDAK membaca ulang
// master data saat menampilkan breakdown. Harga master berubah → banner,
// bukan angka yang berubah sendiri.
//
// Kolom `sku_id` / `work_price_id` di baris L3 sengaja BUKAN foreign key.
// Sama alasannya dengan `WorkPriceProjectRef.project_id` (AGENTS.md §8): yang
// disimpan adalah snapshot id + nama, dan snapshot harus selamat dari apa pun
// yang terjadi pada master data sesudahnya. FK dengan `SetNull` pun tidak
// cukup — ia benar hari ini dan diam-diam salah kalau suatu saat seseorang
// menulis `Cascade`.
//
// Sebaliknya, tabel SETELAN (`BqMaterialProfile`, `BqCategoryWaste`) MEMANG
// ber-FK ke `master_data`: mereka bukan snapshot, mereka pelengkap master
// data, dan baris pelengkap untuk SKU yang tidak ada memang tidak ada artinya.
//
// ----------------------------------------------------------------------------
// PRESISI
// ----------------------------------------------------------------------------
// PRD Bab 3: qty `numeric(18,6)`, uang `numeric(18,4)`. Persentase disimpan
// sebagai FRAKSI (`0.1` = 10%), bukan `10` — supaya tidak ada tempat di mana
// seseorang harus ingat membagi 100.
// ============================================================================

enum BqProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@schema("bq")
}

enum BqLineSource {
  MASTER_DATA
  PROJECT_LOCAL

  @@schema("bq")
}

/// Setelan global kantor. Satu baris, `id` dikunci ke `SETTINGS_ID`
/// (`src/subapps/bq/lib/constants.ts`) — pola yang sama dengan
/// `studioflow.SystemConfig`.
model BqSettings {
  id String @id

  /// Fraksi. 0.2 = 20%. Menjawab PRD §11 open decision 1: ADA default kantor,
  /// DAN ia bisa di-override per object — nilainya disalin ke `BqObject`
  /// saat object dibuat, jadi mengubah default di sini tidak pernah mengubah
  /// object yang sudah ada (alasan yang sama dengan snapshot harga).
  default_markup_pct Decimal @default(0.2) @db.Decimal(9, 6)

  currency String @default("IDR")

  updated_at      DateTime? @updatedAt
  updated_by_name String?

  @@schema("bq")
}

/// Wadah project BQ. BERDIRI SENDIRI dari `studioflow.Project` (keputusan
/// owner 2026-08-19, sejalan dengan PRD §0.1 "database proyek terpisah").
///
model BqProject {
  id String @id @default(uuid())

  /// Bebas diisi kantor. Tidak mengikuti Project Naming Protocol StudioFlow —
  /// BQ boleh ada sebelum nomor project terbit.
  code String?
  name String

  status BqProjectStatus @default(DRAFT)
  notes  String?

  created_by_id   String?
  created_by_name String?

  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  deleted_at      DateTime?
  updated_by_name String?

  objects BqObject[]

  @@index([status, deleted_at])
  @@index([deleted_at])
  @@schema("bq")
}

/// L1 — satu fixture utuh yang jadi satu baris BQ.
///
/// `rate` TIDAK disimpan. Ia dihitung `computeObject()` dari baris di
/// bawahnya setiap kali dibaca. Menyimpannya berarti punya dua sumber
/// kebenaran yang bisa selisih, dan yang tersimpan selalu yang dipercaya
/// orang. Yang membekukan angka di BQ adalah snapshot di baris L3, bukan
/// hasil hitung di L1.
model BqObject {
  id         String    @id @default(uuid())
  project_id String
  project    BqProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  code String?
  name String

  qty  Decimal @default(1) @db.Decimal(18, 6)
  unit String  @default("unit")

  /// Fraksi. Disalin dari `BqSettings.default_markup_pct` saat object dibuat.
  /// Markup diterapkan di L1, bukan per baris L3 (PRD §3.4): ia keputusan
  /// komersial atas satu fixture utuh, bukan atas sebatang edging.
  ///
  /// TIDAK PERNAH tercetak ke klien — klien lihat rate saja.
  markup_pct Decimal @default(0.2) @db.Decimal(9, 6)

  /// Presedensi waste level 2 — "seluruh object ini waste 5%". NULL = tidak
  /// di-override; 0 adalah nilai sah yang menang atas default bahan.
  waste_override_pct Decimal? @db.Decimal(9, 6)

  sort_order Int     @default(0)
  notes      String?

  /// Object terkunci tidak menerima refresh harga apa pun, banner pun tidak
  /// muncul (PRD §5.4).
  locked_at      DateTime?
  locked_by_name String?

  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  deleted_at      DateTime?
  updated_by_name String?

  sub_objects BqSubObject[]

  @@index([project_id, sort_order])
  @@index([deleted_at])
  @@schema("bq")
}

/// L2 — bagian dari fixture, dengan QTY PENGALI sendiri.
///
/// Inilah kunci desain seluruh alat ini (PRD §2.1). Estimator menulis
/// kebutuhan untuk SATU ambalan (0,50 sqm) lalu set jumlahnya 3. Ubah jadi 5,
/// seluruh bahan di bawahnya ikut. Tanpa `qty` di lapis ini, alat ini cuma
/// Excel yang lebih rapi — estimator tetap harus menghitung 0,50 × 3 di
/// kepalanya dan menghitung ulang semuanya saat jumlah ambalan berubah.
model BqSubObject {
  id        String   @id @default(uuid())
  object_id String
  object    BqObject @relation(fields: [object_id], references: [id], onDelete: Cascade)

  name String

  /// Berapa banyak sub-object ini di dalam 1 object.
  qty Decimal @default(1) @db.Decimal(18, 6)

  /// Link ke template library (R2). NULL = standalone (◇); non-null = instance
  /// (⧉). Setiap mutasi baris L3 memutuskan link ini secara otomatis
  /// (copy-on-write di `detachFromTemplate`). Kalau template dihapus dari
  /// library, `onDelete: SetNull` memastikan sub-object tetap hidup sebagai ◇.
  library_sub_object_id String?
  library_sub_object    BqLibrarySubObject? @relation(fields: [library_sub_object_id], references: [id], onDelete: SetNull)

  sort_order Int     @default(0)
  notes      String?

  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  updated_by_name String?

  material_lines BqMaterialLine[]
  service_lines  BqServiceLine[]

  @@index([object_id, sort_order])
  @@index([library_sub_object_id])
  @@schema("bq")
}

/// L3 bahan. Semua kolom `snapshot_*` dibekukan saat baris dibuat dan TIDAK
/// PERNAH dibaca ulang dari master data (PRD §5.4).
///
/// Estimator boleh menyunting nilai snapshot langsung di BQ (keputusan owner
/// 2026-08-19: *"kalau mau diedit via BQ saja bisa — nanti jadi snapshot saja
/// levelnya, tiap project BQ punya snapshot sendiri"*). Suntingan itu hidup
/// di baris ini saja: ia tidak pernah merambat balik ke Master Data, dan
/// ditandai `is_manual_override` supaya Internal Cost Detail bisa
/// membedakannya dari angka yang datang apa adanya dari master.
///
/// Yang TIDAK boleh: baris yang tidak pernah menunjuk master data sama sekali.
/// Master data adalah SSOT — bahan yang belum ada di sana harus diminta ke
/// staff lewat Master Data lebih dulu. `sku_id` nullable hanya untuk baris
/// yang SKU-nya benar-benar lenyap sesudahnya, bukan pintu masuk baris karangan.
model BqMaterialLine {
  id            String      @id @default(uuid())
  sub_object_id String
  sub_object    BqSubObject @relation(fields: [sub_object_id], references: [id], onDelete: Cascade)

  /// Kolom biasa, BUKAN FK — lihat catatan snapshot di kepala blok ini.
  sku_id            String?
  sku_price_id      String?
  supplier_party_id String?
  source            BqLineSource @default(MASTER_DATA)

  /// Kebutuhan untuk SATU sub-object, dalam `snapshot_usage_unit`.
  qty_per_sub Decimal @db.Decimal(18, 6)

  /// Presedensi waste level 1. NULL = tidak di-override. 0 eksplisit adalah
  /// nilai sah yang menang atas seluruh default di bawahnya (PRD §4.1, AT-04).
  waste_override_pct Decimal? @db.Decimal(9, 6)

  // --- snapshot identitas -------------------------------------------------
  snapshot_name          String
  snapshot_code          String?
  snapshot_brand_name    String?
  snapshot_category_path String?
  snapshot_supplier_name String?

  // --- snapshot satuan & harga -------------------------------------------
  snapshot_usage_unit    String?
  snapshot_purchase_unit String?

  /// Konversi saat baris dibuat. Ikut dibekukan karena ia bagian dari
  /// MENDEFINISIKAN harga, bukan tingkat detail (PRD §4).
  snapshot_conversion Decimal? @db.Decimal(18, 6)

  /// Harga per PURCHASE unit. Bukan per usage unit — pembagiannya terjadi di
  /// mesin hitung, bukan di simpanan, supaya asal angkanya tetap terlihat.
  snapshot_price    Decimal @db.Decimal(18, 4)
  snapshot_currency String  @default("IDR")

  // --- snapshot asumsi estimasi -------------------------------------------
  /// Presedensi level 3 dan 4 disimpan TERPISAH, bukan sudah dikerucutkan
  /// jadi satu angka. Kalau digabung, `wasteSource` tidak bisa lagi menjawab
  /// "kenapa waste-nya 10%" — dan AT-03 tidak bisa diuji di mesin hitung.
  snapshot_material_default_waste_pct Decimal? @db.Decimal(9, 6)
  snapshot_category_default_waste_pct Decimal? @db.Decimal(9, 6)

  snapshot_minimum_order      Decimal? @db.Decimal(18, 6)
  snapshot_rounding_increment Decimal  @default(1) @db.Decimal(18, 6)

  // --- provenance ---------------------------------------------------------
  snapshot_price_valid_from    DateTime?
  snapshot_price_verified_from DateTime?
  snapshot_taken_at            DateTime  @default(now())

  /// TRUE kalau estimator menyunting salah satu nilai snapshot di dalam BQ.
  is_manual_override Boolean @default(false)
  override_note      String?

  sort_order Int     @default(0)
  notes      String?

  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  updated_by_name String?

  @@index([sub_object_id, sort_order])
  @@index([sku_id])
  @@schema("bq")
}

/// L3 jasa. Tanpa waste, tanpa konversi, tanpa minimum order — dan itu
/// ditegakkan oleh KETIADAAN kolomnya di sini, bukan oleh cek aplikasi
/// (PRD §3.2, AT-07).
///
/// Kalau suatu saat `waste_override_pct` muncul di tabel ini, yang salah
/// adalah migrasinya. Jangan menambahkannya "supaya seragam dengan bahan".
model BqServiceLine {
  id            String      @id @default(uuid())
  sub_object_id String
  sub_object    BqSubObject @relation(fields: [sub_object_id], references: [id], onDelete: Cascade)

  work_price_id   String?
  vendor_party_id String?
  source          BqLineSource @default(MASTER_DATA)

  /// Kebutuhan untuk SATU sub-object, dalam `snapshot_rate_unit`.
  qty_per_sub Decimal @db.Decimal(18, 6)

  snapshot_name          String
  snapshot_code          String?
  snapshot_category_path String?
  snapshot_vendor_name   String?

  /// PRD §5.3: sqm, m', pcs, ls, org-hari.
  snapshot_rate_unit String

  snapshot_price    Decimal @db.Decimal(18, 4)
  snapshot_currency String  @default("IDR")

  /// PRD §5.3 menyebutnya penting: "Jasa Pasang HPL" harus jelas sudah
  /// termasuk lem atau belum. Dibekukan bersama harganya karena scope yang
  /// berubah di master adalah harga yang berubah artinya.
  snapshot_scope_note String?

  /// `WorkPrice.kind = MATERIAL_LABOR` — paket supply-and-install. Dibekukan
  /// supaya Internal Cost Detail bisa menjelaskan kenapa sebuah baris jasa
  /// tampak mahal tanpa harus menebaknya dari harga.
  snapshot_has_material Boolean @default(false)

  snapshot_price_valid_from DateTime?
  snapshot_taken_at         DateTime  @default(now())

  is_manual_override Boolean @default(false)
  override_note      String?

  sort_order Int     @default(0)
  notes      String?

  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  updated_by_name String?

  @@index([sub_object_id, sort_order])
  @@index([work_price_id])
  @@schema("bq")
}

// =============================================================================
// Library — resep yang bisa dipanggil ulang
// =============================================================================
// Dua tabel terpisah (L1 dan L2) karena dipanggil di tempat berbeda.
// Tidak ada kolom snapshot_* — library menyimpan resep, bukan angka terkunci.
// =============================================================================

/// Library L1 — satu fixture utuh yang bisa dipanggil di project lain.
model BqLibraryObject {
  id   String @id @default(uuid())
  code String?
  name String

  unit        String
  markup_pct  Decimal @db.Decimal(9, 6)
  notes       String?

  created_by_name String
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  deleted_at      DateTime?

  sub_objects BqLibrarySubObjectOfObject[]

  @@schema("bq")
}

/// Sub-object yang disimpan di dalam L1 library — BUKAN FK ke BqLibrarySubObject.
/// Supaya mengubah "Ambalan standar" tidak diam-diam mengubah setiap L1 yang
/// pernah memakainya. Pola yang sama dengan snapshot di baris L3.
model BqLibrarySubObjectOfObject {
  id                 String @id @default(uuid())
  library_object_id  String
  library_object     BqLibraryObject @relation(fields: [library_object_id], references: [id], onDelete: Cascade)

  name  String
  qty   Decimal @db.Decimal(18, 6)
  notes String?

  sort_order Int @default(0)

  materials BqLibraryMaterialLine[]
  services  BqLibraryServiceLine[]

  @@index([library_object_id, sort_order])
  @@schema("bq")
}

/// Library L2 — sub-object berdiri sendiri yang bisa dipanggil langsung.
model BqLibrarySubObject {
  id   String @id @default(uuid())
  name String
  qty  Decimal @db.Decimal(18, 6)

  notes String?

  created_by_name String
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  deleted_at      DateTime?

  materials  BqLibraryMaterialLine[]
  services   BqLibraryServiceLine[]
  /// Instance BqSubObject yang terhubung ke template ini.
  instances  BqSubObject[]

  @@schema("bq")
}

/// Baris material di library — menyimpan resep, bukan snapshot.
model BqLibraryMaterialLine {
  id String @id @default(uuid())

  // FK ke salah satu dari dua parent (keduanya nullable, validasi di app layer)
  sub_object_of_object_id String?
  sub_object_of_object    BqLibrarySubObjectOfObject? @relation(fields: [sub_object_of_object_id], references: [id], onDelete: Cascade)
  sub_object_id           String?
  sub_object              BqLibrarySubObject? @relation(fields: [sub_object_id], references: [id], onDelete: Cascade)

  source         BqLineSource @default(MASTER_DATA)
  sku_id         String?
  recipe_name    String?
  recipe_code    String?
  recipe_brand_name    String?
  recipe_supplier_name String?
  recipe_usage_unit    String?
  recipe_purchase_unit String?
  recipe_conversion    Decimal? @db.Decimal(18, 6)
  recipe_price         Decimal? @db.Decimal(18, 4)
  recipe_currency      String?
  recipe_default_waste_pct Decimal? @db.Decimal(9, 6)
  recipe_minimum_order Decimal? @db.Decimal(18, 6)
  recipe_rounding_increment Decimal? @db.Decimal(18, 6)
  qty_per_sub    Decimal  @db.Decimal(18, 6)
  waste_override_pct Decimal? @db.Decimal(9, 6)
  notes          String?
  sort_order     Int      @default(0)

  @@index([sub_object_of_object_id])
  @@index([sub_object_id])
  @@schema("bq")
}

/// Baris jasa di library — menyimpan resep, bukan snapshot.
model BqLibraryServiceLine {
  id String @id @default(uuid())

  sub_object_of_object_id String?
  sub_object_of_object    BqLibrarySubObjectOfObject? @relation(fields: [sub_object_of_object_id], references: [id], onDelete: Cascade)
  sub_object_id           String?
  sub_object              BqLibrarySubObject? @relation(fields: [sub_object_id], references: [id], onDelete: Cascade)

  source        BqLineSource @default(MASTER_DATA)
  work_price_id String?
  recipe_name   String?
  recipe_code   String?
  recipe_vendor_name String?
  recipe_rate_unit String?
  recipe_price  Decimal? @db.Decimal(18, 4)
  recipe_currency String?
  recipe_scope_note String?
  recipe_has_material Boolean?
  qty_per_sub   Decimal @db.Decimal(18, 6)
  sort_order    Int     @default(0)
  notes         String?

  @@index([sub_object_of_object_id])
  @@index([sub_object_id])
  @@schema("bq")
}
