generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                   @id @default(uuid())
  name                 String
  email                String                   @unique
  password             String
  role                 Role                     @default(STAFF)
  audit_logs           AuditLog[]
  assigned_cd_drawings CDList[]
  comments             Comment[]
  projects_as_designer Project[]                @relation("Designer")
  projects_as_drafter  Project[]                @relation("Drafter")
  product_requests     ProjectProductRequest[]
  assigned_activities  Activity[]
}

model Client {
  id         String    @id @default(uuid())
  name       String    @unique
  address    String?
  logo_url   String?
  updated_at DateTime  @updatedAt
  projects   Project[]
}

model Project {
  id                String                   @id @default(uuid())
  name              String
  pic_designer_id   String
  pic_drafter_id    String
  clientId          String?
  opening_date      DateTime?
  core_project_type String                   @default("RETAIL")
  status_progress   ProjectStatus            @default(ACTIVE)
  priority          ProjectPriority          @default(NORMAL)
  client_contact    String?
  address           String?
  area              Float?
  audit_logs        AuditLog[]
  comments          Comment[]
  phases            Phase[]
  client            Client?                  @relation(fields: [clientId], references: [id])
  designer          User                     @relation("Designer", fields: [pic_designer_id], references: [id])
  drafter           User                     @relation("Drafter", fields: [pic_drafter_id], references: [id])
  checklists        ProjectChecklist[]
  product_requests  ProjectProductRequest[]
  schedule_entries  ProjectScheduleEntry[]
  timelines         ProjectTimeline[]
  activities        Activity[]
}

model Phase {
  id          String             @id @default(uuid())
  project_id  String
  name_enum   PhaseName
  status_enum PhaseStatus        @default(PENDING)
  order_index Int
  is_locked      Boolean            @default(false)
  allow_parallel Boolean            @default(false)
  audit_logs     AuditLog[]
  cd_lists       CDList[]
  comments       Comment[]
  project        Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  checklists     ProjectChecklist[]
  timelines      ProjectTimeline[]
  revisions      Revision[]
}

model Revision {
  id          String         @id @default(uuid())
  phase_id    String
  major       Int            @default(1)
  minor       Int            @default(0)
  status_enum RevisionStatus @default(ACTIVE)
  created_at  DateTime       @default(now())
  activities  Activity[]
  files       File[]
  phase       Phase          @relation(fields: [phase_id], references: [id], onDelete: Cascade)
}

model Activity {
  id                    String         @id @default(uuid())
  project_id            String?
  revision_id           String?
  content               String
  mode                  ActivityMode   @default(TODO)
  status                ActivityStatus @default(OPEN)
  assigned_to_id        String?
  phase_id              String?
  deferred_from_version String?
  created_at            DateTime       @default(now())
  updated_at            DateTime?      @updatedAt

  project Project? @relation(fields: [project_id], references: [id], onDelete: Cascade)

  revision    Revision? @relation(fields: [revision_id], references: [id], onDelete: Cascade)
  assigned_to User?     @relation(fields: [assigned_to_id], references: [id])
}

model File {
  id          String   @id @default(uuid())
  revision_id String
  file_url    String
  file_name   String
  file_type   String
  uploaded_by String
  link_url    String?
  is_external Boolean  @default(false)
  created_at  DateTime @default(now())
  revision    Revision @relation(fields: [revision_id], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String    @id @default(uuid())
  action      String
  entity_type String
  entity_id   String
  user_id     String
  project_id  String?
  phase_id    String?
  details     Json?
  created_at  DateTime  @default(now())
  reverted_at DateTime?
  phase       Phase?    @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [user_id], references: [id])
}

model ProjectTimeline {
  id         String         @id @default(uuid())
  project_id String
  status     TimelineStatus @default(NOT_STARTED)
  start_date DateTime?
  end_date   DateTime?
  phase_id   String?
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  phase      Phase?         @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

model TimelineTemplate {
  id            String @id @default(uuid())
  phase_enum    String @unique
  duration_days Int    @default(7)
}

model ChecklistTemplate {
  id         String  @id @default(uuid())
  phase_enum String?
  label      String
  is_active  Boolean @default(true)
}

model SystemConfig {
  id                     String  @id @default("default")
  app_title              String  @default("StudioFlow")
  is_auto_naming_enabled Boolean @default(true)
  ui_settings            Json?
}

model Vendor {
  id            String            @id @default(uuid())
  brand_name    String            @unique
  company_name  String?
  company_pt    String?
  address       String?
  website_url   String?
  instagram_url String?
  deleted_at    DateTime?
  products      ProductCatalog[]
  contacts      VendorContact[]
}


model VendorContact {
  id             String  @id @default(uuid())
  vendor_id      String
  contact_person String
  contact_role   String
  phone_number   String?
  email          String?
  vendor         Vendor  @relation(fields: [vendor_id], references: [id])
}

model ProductCatalog {
  id                  String                   @id @default(uuid())
  vendor_id           String
  catalog_category    String
  catalog_sub_category String?
  catalog_sku         String
  catalog_brand       String?
  catalog_product_name String?
  catalog_motif       String?
  tags                String[]                 @default([])
  catalog_dimension_p String?
  catalog_dimension_l String?
  catalog_dimension_t String?
  catalog_dimension_unit String?               @default("cm")
  catalog_color       String?
  catalog_finishing   String?
  catalog_image_url   String?
  catalog_image_original_url String?
  catalog_reference_url String?
  catalog_folder_url  String?
  metadata            Json?
  catalog_price       Float?
  created_at          DateTime                 @default(now())
  status              LibraryItemStatus        @default(PENDING)
  deleted_at          DateTime?
  vendor              Vendor                   @relation(fields: [vendor_id], references: [id])
  physical_samples    PhysicalSample[]
  product_requests    ProjectProductRequest[]
  schedule_options    ProjectScheduleOption[]

  @@index([vendor_id])
  @@index([catalog_category])
  @@index([catalog_brand])
}

model PhysicalSample {
  id            String          @id @default(uuid())
  product_id    String
  rack_number   String
  box_number    String
  notes         String?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  product       ProductCatalog  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  movements     SampleMovementLog[]

  @@index([product_id])
}

model SampleMovementLog {
  id         String       @id @default(uuid())
  sample_id  String
  action     SampleAction
  notes      String?
  user_id    String
  created_at DateTime     @default(now())
  sample     PhysicalSample @relation(fields: [sample_id], references: [id], onDelete: Cascade)

  @@index([sample_id])
}

model ProjectProductRequest {
  id                   String               @id @default(uuid())
  project_id           String
  product_catalog_id   String?
  schedule_entry_id    String?
  schedule_option_id   String?
  custom_product_name  String?
  reference_url        String?
  requested_by_id      String
  status               ProductRequestStatus @default(REQUESTED)
  area_location        String?
  is_scheduled         Boolean              @default(true)
  notes                String?
  staff_name_override  String?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  product_catalog      ProductCatalog?      @relation(fields: [product_catalog_id], references: [id])
  schedule_entry       ProjectScheduleEntry? @relation(fields: [schedule_entry_id], references: [id], onDelete: SetNull)
  schedule_option      ProjectScheduleOption? @relation(fields: [schedule_option_id], references: [id], onDelete: SetNull)
  project              Project              @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requested_by         User                 @relation(fields: [requested_by_id], references: [id])
}

model ProjectChecklist {
  id         String  @id @default(uuid())
  project_id String
  phase_id   String?
  label      String
  is_checked Boolean @default(false)
  phase      Phase?  @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

model CDList {
  id             String       @id @default(uuid())
  phase_id       String
  group_code     String
  drawing_name   String
  status_enum    CDItemStatus @default(PENDING)
  assigned_to_id String?
  assigned_to    User?        @relation(fields: [assigned_to_id], references: [id])
  phase          Phase        @relation(fields: [phase_id], references: [id], onDelete: Cascade)
}

model Comment {
  id               String                @id @default(uuid())
  content          String
  author_id        String
  project_id       String
  phase_id         String?
  task_id          String?
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt
  author           User                  @relation(fields: [author_id], references: [id])
  phase            Phase?                @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  project          Project               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  temp_attachments TemporaryAttachment[]
}

model TemporaryAttachment {
  id         String   @id @default(uuid())
  filename   String
  url        String
  file_type  String
  expires_at DateTime
  created_at DateTime @default(now())
  comment_id String?
  comment    Comment? @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
}

model PrefixDictionary {
  id                String                 @id @default(uuid())
  schedule_category String
  prefix            String
  section           ScheduleSection        @default(MATERIAL)
  entries           ProjectScheduleEntry[]

  @@unique([section, schedule_category])
}

model ProjectScheduleEntry {
  id                String                   @id @default(uuid())
  project_id        String
  schedule_category String
  schedule_code     String
  index_number      Int
  schedule_sort_order Int
  schedule_qty     Float?
  schedule_unit    String?
  schedule_location String?
  section           ScheduleSection          @default(MATERIAL)
  prefix_id         String?
  created_at        DateTime                 @default(now())
  updated_at        DateTime                 @updatedAt
  prefix_ref        PrefixDictionary?        @relation(fields: [prefix_id], references: [id])
  project           Project                  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  options           ProjectScheduleOption[]
  product_requests  ProjectProductRequest[]
  @@unique([project_id, section, schedule_code])
}

model ProjectScheduleOption {
  id                  String               @id @default(uuid())
  entry_id            String
  product_catalog_id  String?
  manual_data         Json?
  data_snapshot       Json?
  option_label        String
  is_final            Boolean              @default(false)
  status              ScheduleOptionStatus @default(DRAFT)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  entry               ProjectScheduleEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  product_catalog     ProductCatalog?      @relation(fields: [product_catalog_id], references: [id], onDelete: SetNull)
  product_requests    ProjectProductRequest[]
}

model ScheduleTemplate {
  id                String          @id @default(uuid())
  schedule_category String
  section           ScheduleSection @default(MATERIAL)
  is_active         Boolean         @default(true)

  @@unique([section, schedule_category])
}

model PromotionRequest {
  id               String    @id @default(uuid())
  project_id       String
  schedule_option_id String
  requested_by_id   String
  snapshot_data    Json?
  notes            String?
  status           String    @default("PENDING")
  reviewed_by_id   String?
  reviewed_at      DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
}

enum TimelineStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Role {
  ADMIN
  DIC
  DRIC
  STAFF
}

enum PhaseName {
  MOODBOARD
  LAYOUT
  DESIGN_3D
  CD
  SUPERVISION
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

enum ProjectPriority {
  URGENT
  NORMAL
  LOW
}

enum PhaseStatus {
  PENDING
  IN_PROGRESS
  ON_REVIEW_INTERNAL
  APPROVED_INTERNAL
  ON_REVIEW_CLIENT
  READY_FOR_NEXT
  COMPLETED
}

enum RevisionStatus {
  ACTIVE
  COMPLETED
}

enum ActivityStatus {
  OPEN
  COMPLETED
}

enum ActivityMode {
  TODO
  FEEDBACK
}

enum CDItemStatus {
  PENDING
  IN_PROGRESS
  FINISHED
}

enum LibraryItemStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductRequestStatus {
  REQUESTED
  ORDERED
  SHIPPED
  RECEIVED
  UNAVAILABLE
  CANCELLED
}

enum ScheduleOptionStatus {
  DRAFT
  APPROVED
  NOT_USED
}

enum ScheduleSection {
  MATERIAL
  FIXTURE
}

enum SampleAction {
  IN
  OUT
  TRANSFER
  REJECT
  CHECK_IN
  CHECK_OUT
  AUDITED
}
