generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["studioflow", "master_data", "bq"]
}

model User {
  id                     String                  @id @default(uuid())
  name                   String
  email                  String                  @unique
  password               String
  role                   Role                    @default(STAFF)
  // Soft-delete marker. A removed user keeps its row (so every relation — e.g.
  // Project.designer, Comment.author, AuditLog.user — still resolves to a real
  // name instead of "user not found"), but is hidden from the roster, excluded
  // from login, and no longer offered for new assignments. Re-adding the same
  // email reactivates the row (see userService.executeCreateUser).
  deleted_at             DateTime?
  audit_logs             AuditLog[]
  assigned_cd_drawings   CDList[]
  comments               Comment[]
  created_mom_documents  ProjectMomDocument[]    @relation("MomCreatedBy")
  projects_as_designer   Project[]               @relation("Designer")
  projects_as_drafter    Project[]               @relation("Drafter")
  product_requests       ProjectProductRequest[]
  assigned_activities    Activity[]
  assigned_checklists    ProjectChecklist[]      @relation("ChecklistAssignee")
  checklist_filter_views ChecklistFilterView[]

  @@schema("studioflow")
}

model Client {
  id         String    @id @default(uuid())
  name       String    @unique
  address    String?
  logo_url   String?
  updated_at DateTime  @updatedAt
  projects   Project[]

  @@schema("studioflow")
}

model Project {
  id                String                  @id @default(uuid())
  project_code      String                  @unique
  name              String                  @unique
  pic_designer_id   String
  pic_drafter_id    String
  clientId          String?
  opening_date      DateTime?
  core_project_type String                  @default("RETAIL")
  status_progress   ProjectStatus           @default(ACTIVE)
  priority          ProjectPriority         @default(NORMAL)
  client_contact    String?
  address           String?
  area              Float?
  audit_logs        AuditLog[]
  comments          Comment[]
  phases            Phase[]
  client            Client?                 @relation(fields: [clientId], references: [id])
  designer          User                    @relation("Designer", fields: [pic_designer_id], references: [id])
  drafter           User                    @relation("Drafter", fields: [pic_drafter_id], references: [id])
  checklists        ProjectChecklist[]
  product_requests  ProjectProductRequest[]
  schedule_entries  ProjectScheduleEntry[]
  timelines         ProjectTimeline[]
  activities        Activity[]
  sketchup_projects SketchupProject[]
  mom_documents     ProjectMomDocument[]
  render_boards     RenderBoard[]

  @@schema("studioflow")
}

model Phase {
  id             String      @id @default(uuid())
  project_id     String
  name_enum      PhaseName
  status_enum    PhaseStatus @default(PENDING)
  order_index    Int
  is_locked      Boolean     @default(false)
  allow_parallel Boolean     @default(false)

  /// When status_enum last changed. Drives the "waiting N days" reading in the
  /// UI, which is the single most useful signal for spotting a stalled phase.
  /// Nullable on purpose: for phases that existed before migration
  /// 20260803120000_add_phase_status_changed_at we only know the answer where
  /// an AuditLog row survives. NULL means "unknown" and the UI shows no
  /// duration rather than inventing one. Derivable from AuditLog in principle,
  /// but that is a per-phase scan — too expensive for a project list.
  status_changed_at DateTime?

  audit_logs AuditLog[]
  cd_lists   CDList[]
  comments   Comment[]
  project    Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  checklists ProjectChecklist[]
  timelines  ProjectTimeline[]
  revisions  Revision[]

  @@schema("studioflow")
}

model Revision {
  id          String         @id @default(uuid())
  phase_id    String
  major       Int            @default(1)
  minor       Int            @default(0)
  status_enum RevisionStatus @default(ACTIVE)
  created_at  DateTime       @default(now())
  activities  Activity[]
  files       File[]
  phase       Phase          @relation(fields: [phase_id], references: [id], onDelete: Cascade)

  @@schema("studioflow")
}

model Activity {
  id                    String         @id @default(uuid())
  project_id            String?
  revision_id           String?
  content               String
  mode                  ActivityMode   @default(TODO)
  status                ActivityStatus @default(OPEN)
  assigned_to_id        String?
  phase_id              String?
  deferred_from_version String?

  /// Date-only, same convention as `ProjectChecklist.due_at`: no UI offers a
  /// time picker, so every value lands at midnight.
  ///
  /// Added 2026-08-10 for the Upcoming view. Without it, half of what people
  /// actually chase a deadline on — loose work items and revision feedback —
  /// could never appear on a date-based screen, and a date view that shows
  /// half the work is one nobody trusts.
  due_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  project Project? @relation(fields: [project_id], references: [id], onDelete: Cascade)

  revision    Revision? @relation(fields: [revision_id], references: [id], onDelete: Cascade)
  assigned_to User?     @relation(fields: [assigned_to_id], references: [id])

  @@index([due_at])
  @@schema("studioflow")
}

model File {
  id          String   @id @default(uuid())
  revision_id String
  file_url    String
  file_name   String
  file_type   String
  uploaded_by String
  link_url    String?
  is_external Boolean  @default(false)
  created_at  DateTime @default(now())
  revision    Revision @relation(fields: [revision_id], references: [id], onDelete: Cascade)

  @@schema("studioflow")
}

model AuditLog {
  id      String      @id @default(uuid())
  /// PRD Architecture Cleanup v2 §20 (keputusan owner 2026-08-24): satu tabel
  /// audit generic lintas domain. Baris lama di-backfill 'STUDIOFLOW' oleh
  /// migrasi; MasterDataAudit digabung lewat dual-write + backfill terjadwal.
  domain     AuditDomain @default(STUDIOFLOW)
  action      String
  entity_type String
  entity_id   String
  /// Actor StudioFlow (FK). NULL untuk domain MASTER_DATA/BQ yang actornya
  /// disimpan sebagai plain column actor_id/actor_name (batas schema §8).
  user_id     String?
  project_id  String?
  phase_id    String?
  actor_id    String?
  actor_name  String?
  details     Json?
  created_at  DateTime  @default(now())
  reverted_at DateTime?
  phase       Phase?    @relation(fields: [phase_id], references: [id], onDelete: SetNull)
  project     Project?  @relation(fields: [project_id], references: [id], onDelete: SetNull)
  user        User?     @relation(fields: [user_id], references: [id])

  @@index([domain, entity_type, entity_id, created_at])
  @@schema("studioflow")
}

enum AuditDomain {
  STUDIOFLOW
  MASTER_DATA
  BQ

  @@schema("studioflow")
}

model ProjectTimeline {
  id         String         @id @default(uuid())
  project_id String
  status     TimelineStatus @default(NOT_STARTED)
  start_date DateTime?
  end_date   DateTime?
  phase_id   String?
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  phase      Phase?         @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@schema("studioflow")
}

model TimelineTemplate {
  id            String @id @default(uuid())
  phase_enum    String @unique
  duration_days Int    @default(7)

  @@schema("studioflow")
}

model ChecklistTemplate {
  id         String  @id @default(uuid())
  phase_enum String?
  label      String
  is_active  Boolean @default(true)

  generated_items ProjectChecklist[]

  @@schema("studioflow")
}

model SystemConfig {
  id                     String  @id @default("default")
  app_title              String  @default("StudioFlow")
  is_auto_naming_enabled Boolean @default(true)
  ui_settings            Json?

  @@schema("studioflow")
}

// =============================================================================
// MASTER DATA v2 — diterapkan 2026-08-10
// =============================================================================
// Sumber : `design database masterdata.xlsx` (Table 1–4) + keputusan owner
//          2026-08-10. Dasar: `docs/PLAN-MASTERDATA-V2.md`,
//          `docs/PENYIMPANGAN-DARI-EXCEL.md`, `docs/TANYA-SEBELUM-EKSEKUSI.md`.
// Migrasi: `prisma/migrations-masterdata-v2/01-04` (dijalankan manual, lihat
//          README di folder itu) + baseline resmi di `prisma/migrations/`.
//
// StudioFlow membaca TEPAT SATU view: `v_library_brand`. Schedule dan
// SketchUp TIDAK memilih SKU dari Master Data — lihat kolom snapshot di
// ProjectProductRequest/ProjectScheduleOption di bawah.
// =============================================================================

model Party {
  id String @id @default(uuid())

  /// Nama dagang. Excel Table 1 kolom B.
  /// TIDAK `@unique` sejak 2026-08-18 — dijaga index PARSIAL, bukan index polos.
  ///
  /// Tabel ini memakai soft-delete. `@unique` tanpa syarat berarti baris yang
  /// sudah dihapus tetap memegang namanya selamanya, sehingga nama supplier yang
  /// pernah dihapus tidak pernah bisa dipakai lagi, dan setiap quick-create yang
  /// menemukannya berakhir menabrak index. Prisma tidak bisa menyatakan
  /// `WHERE deleted_at IS NULL` di `@unique`, jadi jaminannya ditulis SQL di
  /// `20260818120000_masterdata_live_unique_indexes` — pola yang sama dengan
  /// `Sku_slug_nobrand_uniq` dan `Sku_brand_code_uniq` di `03_invariants.sql`.
  ///
  /// Index itu juga `lower(name)`: nama dagang tidak peka huruf besar-kecil.
  ///
  /// KONSEKUENSI UNTUK KODE: `findUnique({ where: { name } })` tidak lagi sah.
  /// Pakai `findFirst({ where: { name, deleted_at: null } })`.
  name String
  slug String

  /// Badan hukum terdaftar. Excel Table 1 kolom A. NULL kalau tidak diketahui.
  legal_name String?

  type PartyType @default(COMPANY)

  address String?
  notes   String?

  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  updated_by_name String?

  roles    PartyRole[]
  contacts PartyContact[]
  links    PartyLink[]

  owned_brands    Brand[]         @relation("BrandOwner")
  supplied_brands BrandSupplier[]
  supplied_prices SkuPrice[]      @relation("SkuPriceSupplier")
  work_prices     WorkPrice[]     @relation("WorkPriceVendor")

  @@index([slug])
  @@index([type])
  @@index([is_active])
  @@index([deleted_at])
  @@schema("master_data")
}

model PartyRole {
  id       String        @id @default(uuid())
  party_id String
  role     PartyRoleKind
  notes    String?

  party Party @relation(fields: [party_id], references: [id], onDelete: Cascade)

  @@unique([party_id, role])
  @@index([role])
  @@schema("master_data")
}

model PartyContact {
  id       String @id @default(uuid())
  party_id String

  person_name String
  job_title   String?

  phone String?
  email String?

  is_primary Boolean @default(false)
  notes      String?

  /// Kontak khusus satu merek di perusahaan ini. NULL = kontak umum.
  brand_id String?
  brand    Brand?  @relation(fields: [brand_id], references: [id], onDelete: SetNull)

  party Party @relation(fields: [party_id], references: [id], onDelete: Cascade)

  @@index([party_id])
  @@index([brand_id])
  @@schema("master_data")
}

model PartyLink {
  id       String   @id @default(uuid())
  party_id String
  kind     LinkKind
  url      String

  archive_url String?
  label       String?
  sort_order  Int     @default(0)

  party Party @relation(fields: [party_id], references: [id], onDelete: Cascade)

  @@unique([party_id, url])
  @@index([party_id, kind])
  @@schema("master_data")
}

model Brand {
  id String @id @default(uuid())

  /// TIDAK `@unique` sejak 2026-08-18 — dijaga index PARSIAL, bukan index polos.
  ///
  /// Tabel ini memakai soft-delete. `@unique` tanpa syarat berarti baris yang
  /// sudah dihapus tetap memegang namanya selamanya, sehingga nama supplier yang
  /// pernah dihapus tidak pernah bisa dipakai lagi, dan setiap quick-create yang
  /// menemukannya berakhir menabrak index. Prisma tidak bisa menyatakan
  /// `WHERE deleted_at IS NULL` di `@unique`, jadi jaminannya ditulis SQL di
  /// `20260818120000_masterdata_live_unique_indexes` — pola yang sama dengan
  /// `Sku_slug_nobrand_uniq` dan `Sku_brand_code_uniq` di `03_invariants.sql`.
  ///
  /// Index itu juga `lower(name)`: nama dagang tidak peka huruf besar-kecil.
  ///
  /// KONSEKUENSI UNTUK KODE: `findUnique({ where: { name } })` tidak lagi sah.
  /// Pakai `findFirst({ where: { name, deleted_at: null } })`.
  name String
  slug String

  owner_party_id String?
  owner          Party?  @relation("BrandOwner", fields: [owner_party_id], references: [id], onDelete: SetNull)

  notes String?

  /// Hashtag bebas — lebih umum & awam dibanding Category (mis. "batu",
  /// "tegel murah", "finishing lantai"). Ditambahkan 2026-08-18 (owner
  /// feedback item 5): Category tetap daftar ~40 opsi terkurasi lewat
  /// checklist, tags ini pool bebas via CreatableTagInput yang sama dipakai
  /// SKU. Tidak ada tabel terpisah — tags brand tidak perlu di-slug atau
  /// dibagi lintas entity seperti Category.
  tags String[] @default([])

  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  deleted_at      DateTime?
  updated_by_name String?

  categories BrandCategory[]
  skus       Sku[]
  links      BrandLink[]
  suppliers  BrandSupplier[]

  scoped_contacts PartyContact[]

  @@index([slug])
  @@index([owner_party_id])
  @@index([deleted_at])
  @@schema("master_data")
}

model BrandLink {
  id       String   @id @default(uuid())
  brand_id String
  kind     LinkKind
  url      String

  archive_url String?
  label       String?
  sort_order  Int     @default(0)

  brand Brand @relation(fields: [brand_id], references: [id], onDelete: Cascade)

  price_sources SkuPrice[] @relation("SkuPriceSourceLink")

  @@unique([brand_id, url])
  @@index([brand_id, kind])
  @@schema("master_data")
}

model BrandSupplier {
  id       String @id @default(uuid())
  brand_id String
  party_id String

  is_authorized Boolean @default(false)
  notes         String?

  brand Brand @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  party Party @relation(fields: [party_id], references: [id], onDelete: Cascade)

  @@unique([brand_id, party_id])
  @@index([party_id])
  @@schema("master_data")
}

model Category {
  id String @id @default(uuid())

  name String
  slug String

  kind CategoryKind

  parent_id String?
  parent    Category?  @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")

  /// Materialized path ("bahan-baku/plywood") untuk `LIKE 'bahan-baku/%'` —
  /// AGENTS.md §4. DIPELIHARA OTOMATIS oleh `upsertCategory()` +
  /// `propagateDescendantPaths()` di `category-tree-service.ts` (B7,
  /// 2026-08-18): rename/re-parent sebuah kategori menulis ulang path
  /// SELURUH keturunannya lewat prefix match, dalam transaksi yang sama.
  /// Audit skema 2026-08-19 sempat mencatat ini sebagai risiko tak terjamin
  /// — KOREKSI: sudah ditangani sejak B7, bukan celah terbuka. Jangan tulis
  /// kolom ini manual di luar fungsi itu.
  path String?

  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  brands      BrandCategory[]
  skus        SkuCategory[]
  work_prices WorkPrice[]

  // `(kind, slug)` TIDAK LAGI `@unique` sejak 2026-08-19 (audit skema, item
  // 3) — dijaga index PARSIAL `Category_kind_slug_live_uniq` (WHERE
  // is_active), pola yang sama dengan Party/Brand name/slug live-uniq
  // (20260818120000, lihat AGENTS.md §2). Category tidak punya `deleted_at`
  // (tidak soft-delete), jadi "hidup" di sini berarti `is_active`, bukan
  // `deleted_at IS NULL`. Category BELUM punya action delete/nonaktifkan
  // apa pun hari ini (audit skema 2026-08-19, temuan #3) — fix ini murni
  // pencegahan sebelum fitur itu ada, supaya kalau nanti "nonaktifkan
  // kategori" dibangun, slug yang dinonaktifkan bisa dipakai ulang, bukan
  // terkunci selamanya seperti B2 sebelum ditambal untuk Party/Brand.
  @@index([kind, slug])
  @@index([kind, parent_id, sort_order])
  @@index([path])
  @@schema("master_data")
}

model BrandCategory {
  id          String @id @default(uuid())
  brand_id    String
  category_id String
  sort_order  Int    @default(0)

  source     CategorySource @default(DERIVED_FROM_SKU)
  created_at DateTime       @default(now())

  brand    Brand    @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@unique([brand_id, category_id])
  @@index([category_id])
  @@index([brand_id, sort_order])
  @@schema("master_data")
}

model SkuCategory {
  id          String @id @default(uuid())
  sku_id      String
  category_id String

  is_primary Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  sku      Sku      @relation(fields: [sku_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@unique([sku_id, category_id])
  @@index([category_id])
  @@index([sku_id, sort_order])
  @@schema("master_data")
}

model Sku {
  id String @id @default(uuid())

  /// Kode artikel pabrikan. NULLABLE (Q7) — workbook sumber tidak punya kolom
  /// SKU eksplisit; keunikannya di mana terisi dijaga partial unique index.
  code String?

  name String
  slug String

  /// NULLABLE (Q7) — barang generik ("plywood 9mm") sah tanpa brand.
  ///
  /// `onDelete: Restrict` mencegah HARD DELETE Brand yang masih punya Sku —
  /// tapi Brand memakai soft-delete (`deleted_at`), dan belum ada action
  /// delete Brand di manapun di repo (audit skema 2026-08-19, temuan #5).
  /// Restrict ini belum pernah benar-benar dieksekusi. KALAU nanti "delete
  /// brand" dibangun mengikuti pola soft-delete tabel lain, Restrict TIDAK
  /// akan terpicu — proteksi "jangan hapus brand yang masih dipakai SKU
  /// aktif" harus ditulis eksplisit di application code (mirip
  /// `assertPartyDeletable` untuk Party), jangan diasumsikan dari FK ini.
  brand_id String?
  brand    Brand?  @relation(fields: [brand_id], references: [id], onDelete: Restrict)

  kind   SkuKind   @default(MATERIAL)
  status SkuStatus @default(DRAFT)

  spec Json?

  dim_length  Decimal? @db.Decimal(12, 3)
  dim_width   Decimal? @db.Decimal(12, 3)
  dim_height  Decimal? @db.Decimal(12, 3)
  dim_unit    String?  @default("mm")
  dim_display String?

  base_unit String

  // ── BQ costing fields (pindahan dari BqMaterialProfile) ────────────────
  // Sebelumnya hidup di bq.BqMaterialProfile. Dipindahkan 2026-08-19 agar
  // SKU baru langsung siap dipakai BQ tanpa langkah tambahan.
  usage_unit         String?
  purchase_unit      String?
  conversion         Decimal?  @db.Decimal(18,6)   // CHECK > 0 di app layer
  default_waste_pct  Decimal?  @db.Decimal(9,6)    // presedensi level 3
  minimum_order      Decimal?  @db.Decimal(18,6)
  rounding_increment Decimal?  @db.Decimal(18,6)   // default 1
  preferred_supplier_party_id String?  // preferensi supplier untuk BQ

  notes String?

  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  deleted_at      DateTime?
  updated_by_name String?

  categories SkuCategory[]
  media      SkuMedia[]
  prices     SkuPrice[]
  samples    Sample[]

  @@unique([brand_id, slug])
  @@index([brand_id])
  @@index([kind, status])
  @@index([deleted_at])
  @@schema("master_data")
}

model SkuMedia {
  id         String    @id @default(uuid())
  sku_id     String
  kind       MediaKind
  url        String
  label      String?
  sort_order Int       @default(0)
  created_at DateTime  @default(now())

  sku Sku @relation(fields: [sku_id], references: [id], onDelete: Cascade)

  @@unique([sku_id, url])
  @@index([sku_id, kind, sort_order])
  @@schema("master_data")
}

model SkuPrice {
  id     String @id @default(uuid())
  sku_id String
  sku    Sku    @relation(fields: [sku_id], references: [id], onDelete: Cascade)

  supplier_party_id String?
  supplier          Party?  @relation("SkuPriceSupplier", fields: [supplier_party_id], references: [id], onDelete: SetNull)

  /// Harga tunggal yang berlaku. Pasangan `price_list` / `price_net` dihapus
  /// 2026-08-14 (keputusan owner): yang dicatat studio adalah harga yang
  /// benar-benar dipakai, bukan sepasang angka sebelum/sesudah diskon.
  price_net Decimal @db.Decimal(16, 2)
  currency  String  @default("IDR")

  unit String

  valid_from DateTime  @default(now())
  valid_to   DateTime?

  is_current Boolean @default(true)

  source_link_id String?
  source_link    BrandLink? @relation("SkuPriceSourceLink", fields: [source_link_id], references: [id], onDelete: SetNull)

  notes String?

  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  updated_by_name String?
  /// Keputusan owner U4 (R4, 2026-08-24): plain column, tanpa FK — pola sama
  /// dengan `SampleMovement.actor_id`. Aktor hidup di schema `studioflow`;
  /// snapshot harus selamat dari apa pun yang terjadi di sana.
  updated_by_id   String?

  @@index([sku_id, is_current])
  @@index([supplier_party_id])
  @@index([valid_from])
  @@schema("master_data")
}

model WorkPrice {
  id String @id @default(uuid())

  code String @unique
  name String

  category_id String
  category    Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  vendor_party_id String?
  vendor          Party?  @relation("WorkPriceVendor", fields: [vendor_party_id], references: [id], onDelete: SetNull)

  spec        Json?
  dim_display String?

  unit String

  /// SATU harga, sesuai Excel Table 3 dan Table 4 yang keduanya hanya punya
  /// kolom `Price`. Menggantikan `material_price` + `labor_price` +
  /// `total_price` generated (E8, keputusan owner 2026-08-11).
  ///
  /// Yang hilang bersama pemisahan itu memang tidak pernah ada di Excel: paket
  /// supply-and-install dikutip satu angka, dan dua kotak kosong memaksa orang
  /// mengarang pembagiannya — persis kesalahan yang X12 hindari dengan tidak
  /// menebak arti kolom `Qty`.
  price Decimal @db.Decimal(16, 2)

  /// Pembeda Table 3 dari Table 4, dinyatakan bukan disimpulkan.
  ///
  /// Sebelumnya disimpulkan dari `material_price != null`, yang berarti tarif
  /// upah-murni yang kebetulan diketik lengkap dengan biaya materialnya tidak
  /// bisa dibedakan dari paket supply-and-install. Kolom eksplisit membuat
  /// `v_bq_work_rate.has_material` membaca sebuah fakta, bukan tebakan.
  kind WorkPriceKind @default(LABOR_ONLY)

  currency String @default("IDR")

  scope_note String?
  notes      String?

  valid_from DateTime  @default(now())
  is_active  Boolean   @default(true)

  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  deleted_at      DateTime?
