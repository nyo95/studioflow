/// Task list. Holds TWO kinds of row in one table:
///
///   - `template_id != null` — generated from a `ChecklistTemplate`. Regenerable
///     at any time by `executeSyncProjectChecklists`; losing one costs nothing.
///   - `template_id == null` — written by a user. Gone for good if deleted.
///
/// Nearly every rule below exists to keep those two kinds from corrupting each
/// other's assumptions. Read `roadmap.md` §C before changing any of them.
model ProjectChecklist {
  id         String    @id @default(uuid())
  project_id String
  phase_id   String?
  label      String
  is_checked Boolean   @default(false)
  /// Timestamp of the most recent check-off. Set when is_checked becomes
  /// true, cleared when unchecked. Used to purge stale done-items from the
  /// Today feed after CHECKLIST_DONE_RETENTION_DAYS days.
  checked_at DateTime?

  /// Subtask parent. Depth is capped at ONE level in validation
  /// (`MAX_CHECKLIST_DEPTH`), not here — loosening that later needs no
  /// migration, tightening it would.
  parent_id String?

  /// Manual ordering. Ties broken by `created_at`. Both readers
  /// (`phase-heartbeat.ts`, `project-checklist-overview.tsx`) must sort by the
  /// same pair; before this column they each sorted differently and neither
  /// produced insertion order.
  sort_order Int @default(0)

  /// 1 = P1 (highest) … 4 = none. Int rather than an enum so `ORDER BY priority
  /// ASC` is correct by construction; a Prisma enum sorts by declaration
  /// position, which quietly puts meaning on the order the enum was typed in.
  priority Int @default(4)

  /// Date-only by construction: no UI surfaces a time picker, so every value
  /// lands at midnight. A `due_has_time Boolean @default(false)` column can be
  /// added later and every pre-existing row will already be correct.
  due_at DateTime?

  assigned_to_id String?

  /// Origin of the row, and the identity `executeSyncProjectChecklists` dedups
  /// on. Was `${phase_id}::${label}` before — which collided with user-written
  /// rows of the same label AND duplicated rows whenever a template was
  /// renamed. `SetNull` on template delete: the row may already be ticked, so
  /// deleting it would throw away completed work. It simply becomes a plain
  /// task.
  template_id String?

  created_at DateTime @default(now())

  phase       Phase?                 @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  project     Project                @relation(fields: [project_id], references: [id], onDelete: Cascade)
  parent      ProjectChecklist?      @relation("ChecklistTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children    ProjectChecklist[]     @relation("ChecklistTree")
  assigned_to User?                  @relation("ChecklistAssignee", fields: [assigned_to_id], references: [id])
  template    ChecklistTemplate?     @relation(fields: [template_id], references: [id], onDelete: SetNull)
  labels      ChecklistLabelOnItem[]
  comments    Comment[]

  @@index([project_id, parent_id])
  @@index([phase_id, is_checked])
  @@index([assigned_to_id])
  @@schema("studioflow")
}

